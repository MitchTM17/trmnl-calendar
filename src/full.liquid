    #calendar-full-week .black-2 .fc-event-main,
    #calendar-full-week .gray-25-1 .fc-event-main,
    #calendar-full-week .gray-25-2 .fc-event-main,
    #calendar-full-week .gray-30-1 .fc-event-main,
    #calendar-full-week .gray-30-2 .fc-event-main,
    #calendar-full-week .black-1 .fc-event-title,
    #calendar-full-week .black-2 .fc-event-title,
    #calendar-full-week .gray-25-1 .fc-event-title,
    #calendar-full-week .gray-25-2 .fc-event-title,
    #calendar-full-week .gray-30-1 .fc-event-title,
    #calendar-full-week .gray-30-2 .fc-event-title {
        color: white !important;
        -webkit-text-stroke: 0 !important;
        text-shadow: none !important;
    }
    #calendar-full-week .gray-55-1,
    #calendar-full-week .gray-55-2,
    #calendar-full-week .gray-60-1,
    #calendar-full-week .gray-60-2,
