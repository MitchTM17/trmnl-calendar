<link
    rel="stylesheet"
    href="https://trmnl.com/assets/plugins/calendars-8cda8897.css">
<link
    rel="stylesheet"
    href="https://trmnl.com/assets/plugins/calendars_full_week-0e0ce25b.css">
<style>
    /*
     * FullCalendar's own bundled CSS (from the two stylesheets above) was
     * quietly beating our Framework grayscale classes on specificity/order
     * when applied straight to FullCalendar's .fc-event wrapper - even
     * though the exact same classes work fine on a plain <div> (confirmed
     * by testing outside FullCalendar). So instead of fighting that CSS,
     * we neutralize FullCalendar's own event chrome entirely and render
     * our own plain, uncontested inner <div> for every event (built in
     * eventContent below) - structurally identical to the working plain
     * <div class="bg--gray-25 text--white"> test.
     */
    #calendar-full-week .fc-event,
    #calendar-full-week .fc-v-event,
    #calendar-full-week .fc-timegrid-event,
    #calendar-full-week .fc-daygrid-event {
        background: none !important;
        background-color: transparent !important;
        background-image: none !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }
    #calendar-full-week .fc-event-fill {
        display: block;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        padding: 2px 4px;
        overflow: hidden;
    }
    /*
     * Black, gray-30, and gray-55 are the exact non-dithered levels on a
     * 2-bit panel, so plain hex renders them identically to the Framework
     * tokens - kept as hardcoded hex since that's confirmed working.
     * Gray-25 and gray-60 use the real bg--gray-25/bg--gray-60 Framework
     * classes instead (set directly on .fc-event-fill in eventContent),
     * since dithering for those two only exists in TRMNL's own CSS for
     * those specific tokens - a flat hex color can't reproduce it.
     */
    #calendar-full-week .black-1,
    #calendar-full-week .black-2 {
        background-color: #000000 !important;
        border-color: #000000 !important;
    }
    #calendar-full-week .gray-30-1,
    #calendar-full-week .gray-30-2 {
        background-color: #4d4d4d !important;
        border-color: #4d4d4d !important;
    }
    #calendar-full-week .gray-55-1,
    #calendar-full-week .gray-55-2 {
        background-color: #8c8c8c !important;
        border-color: #8c8c8c !important;
    }
    #calendar-full-week .black-1,
    #calendar-full-week .black-2,
    #calendar-full-week .gray-30-1,
    #calendar-full-week .gray-30-2 {
        color: white !important;
        -webkit-text-stroke: 0 !important;
        text-shadow: none !important;
    }
    #calendar-full-week .gray-55-1,
    #calendar-full-week .gray-55-2 {
        color: black !important;
        -webkit-text-stroke: 0 !important;
        text-shadow: none !important;
    }
    #calendar-full-week .fc-timegrid-now-indicator-line {
        height: 2px !important;
        background-color: black !important;
        border: 0 !important;
        z-index: 10 !important;
    }
    #calendar-full-week .fc-timegrid-now-indicator-arrow {
        border-left-color: black !important;
        border-right-color: black !important;
        z-index: 10 !important;
    }
</style>
<div
    id="calendar-full-week"
    class="trmnl-calendar trmnl-calendar--week highlight-today no-weekend-shading now-indicator-full-week">
</div>
<script src="https://usetrmnl.com/fullcalendar/index.global.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var calendarEl = document.getElementById("calendar-full-week");
        if (!calendarEl || typeof FullCalendar === "undefined") {
            return;
        }

        var calendar = new FullCalendar.Calendar(calendarEl, {
            /*
             * Already converted to the user's local time (see the per-slot
             * conversion below). timeZone: "UTC" tells FullCalendar to
             * treat every timestamp as a literal wall-clock value instead
             * of re-converting it, which is what keeps event times from
             * shifting by a few hours.
             */
            now: "{{ trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' }}",
            timeZone: "UTC",

            {% comment %}
                STEP 2 of the backtrack plan: confirmed-working rotation
                (STEP 1) now wrapped in a plain if/else on the
                auto_scroll_enabled toggle. If it's not truthy, skip the
                rotation entirely and just use the fixed 08:00-20:00
                default. Next step after this is confirmed: swap the
                hardcoded 08:00/20:00 default for the custom start/end
                fields.
            {% endcomment %}
            {% if auto_scroll_enabled %}
                {% assign localHour = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: '%H' | plus: 0 %}
                {% assign shiftedHour = localHour | minus: 2 | plus: 24 | modulo: 24 %}
                {% assign bucketIndex = shiftedHour | divided_by: 6 %}
                {% case bucketIndex %}
                    {% when 0 %}
                        {% assign windowStart = "02:00:00" %}
                        {% assign windowEnd = "14:00:00" %}
                    {% when 1 %}
                        {% assign windowStart = "08:00:00" %}
                        {% assign windowEnd = "20:00:00" %}
                    {% when 2 %}
                        {% assign windowStart = "14:00:00" %}
                        {% assign windowEnd = "26:00:00" %}
                    {% else %}
                        {% assign windowStart = "20:00:00" %}
                        {% assign windowEnd = "32:00:00" %}
                {% endcase %}
            {% else %}
                {% assign windowStart = "08:00:00" %}
                {% assign windowEnd = "20:00:00" %}
            {% endif %}

            // CalDAV display settings
            firstDay: {{ caldav_405381.first_day | default: 0 }},
            scrollTime: {{ windowStart | json }},
            slotMinTime: {{ windowStart | json }},
            slotMaxTime: {{ windowEnd | json }},

            // Week-view layout
            headerToolbar: false,
            initialView: "timeGridWeek",
            contentHeight: "100%",
            expandRows: true,
            allDaySlot: true,
            slotDuration: "00:30:00",
            nowIndicator: true,
            displayEventTime: false,

            slotLabelFormat: {
                hour: "numeric",
                meridiem: "short",
                hour12: {% if caldav_405381.time_format == "am/pm" %}true{% else %}false{% endif %}
            },
            eventTimeFormat: {
                hour: "numeric",
                minute: "2-digit",
                hour12: {% if caldav_405381.time_format == "am/pm" %}true{% else %}false{% endif %}
            },

            /*
             * 10 fixed calendar slots, 2 per color (black, gray-25,
             * gray-30, gray-55, gray-60 - white is the page background, so
             * it's not offered as an event color). Each slot's data source
             * is picked by the VIEWING USER via a plugin_instance_select
             * dropdown in the settings form - not a hardcoded plugin name.
             * That's what lets this same template work unmodified for
             * someone else's account with entirely different plugins:
             * their dropdown shows their own plugins.
             *
             * Color is set via fillClass in extendedProps, read by
             * eventContent below to build the actual filled <div> - not
             * classNames on FullCalendar's own event wrapper, which its
             * bundled CSS was overriding.
             *
             * NOTE: plugin_instance_select binds to the plugin instance
             * itself (same shape as a hardcoded private_plugin_XXXXXX
             * reference), so events live under .merge_variables.events,
             * not directly under .events.
             *
             * Trailing commas after each event are intentional and
             * harmless - JS allows them, so no "is this the last item"
             * bookkeeping is needed.
             *
             * Times: raw event times come back as absolute UTC instants
             * (e.g. "...T03:45:00.000Z"). Since FullCalendar is set to
             * timeZone: "UTC" and expects literal wall-clock strings, each
             * time is converted to epoch seconds, shifted by the user's
             * UTC offset, then reformatted with no "Z"/offset suffix.
             * All-day events are left alone (date-only, no time to shift).
             */
            events: [

                {% comment %} ---------- Black - Calendar 1 ---------- {% endcomment %}
                {% if black_1_source %}
                    {% for event in black_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "black-1" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Black - Calendar 2 ---------- {% endcomment %}
                {% if black_2_source %}
                    {% for event in black_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "black-2" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 25 - Calendar 1 ---------- {% endcomment %}
                {% if gray_25_1_source %}
                    {% for event in gray_25_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-25 text--white" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 25 - Calendar 2 ---------- {% endcomment %}
                {% if gray_25_2_source %}
                    {% for event in gray_25_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-25 text--white" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 30 - Calendar 1 ---------- {% endcomment %}
                {% if gray_30_1_source %}
                    {% for event in gray_30_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-30-1" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 30 - Calendar 2 ---------- {% endcomment %}
                {% if gray_30_2_source %}
                    {% for event in gray_30_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-30-2" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 55 - Calendar 1 ---------- {% endcomment %}
                {% if gray_55_1_source %}
                    {% for event in gray_55_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-55-1" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 55 - Calendar 2 ---------- {% endcomment %}
                {% if gray_55_2_source %}
                    {% for event in gray_55_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-55-2" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 60 - Calendar 1 ---------- {% endcomment %}
                {% if gray_60_1_source %}
                    {% for event in gray_60_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-60 text--black" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} ---------- Gray 60 - Calendar 2 ---------- {% endcomment %}
                {% if gray_60_2_source %}
                    {% for event in gray_60_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: trmnl.user.utc_offset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-60 text--black" }
                        },
                    {% endfor %}
                {% endif %}

            ],

            /*
             * Renders each event as one plain, self-owned <div> - the same
             * structure as the plain-div test that proved Framework
             * classes (and dithering) work fine outside of FullCalendar's
             * own markup. FullCalendar's default event chrome is
             * neutralized in the <style> block above, so this div is the
             * only thing painting each event's background/text.
             */
            eventContent: function (info) {
                var fillClass = (info.event.extendedProps && info.event.extendedProps.fillClass) || "";
                var fill = document.createElement("div");
                fill.className = "fc-event-fill " + fillClass;

                var title = document.createElement("div");
                title.className = "fc-event-fill-title";
                title.textContent = info.event.title || "";
                fill.appendChild(title);

                return { domNodes: [fill] };
            }
        });

        calendar.render();

        // Keep the current-time line spanning only the day columns.
        function updateNowIndicatorWidth() {
            try {
                var dayColumns = calendarEl.querySelectorAll("td.fc-timegrid-col:not(.fc-timegrid-axis)");
                var todayColumn = calendarEl.querySelector(".fc-day-today.fc-timegrid-col");
                if (!dayColumns.length || !todayColumn) {
                    return;
                }
                var firstBox = dayColumns[0].getBoundingClientRect();
                var lastBox = dayColumns[dayColumns.length - 1].getBoundingClientRect();
                var todayBox = todayColumn.getBoundingClientRect();

                calendarEl.style.setProperty("--now-indicator-left-offset", (todayBox.left - firstBox.left) + "px");
                calendarEl.style.setProperty("--now-indicator-total-width", (lastBox.right - firstBox.left) + "px");
            } catch (error) {
                // Ignore measurement errors during initial rendering.
            }
        }

        requestAnimationFrame(updateNowIndicatorWidth);
        if (window.ResizeObserver) {
            new ResizeObserver(updateNowIndicatorWidth).observe(calendarEl);
        }
    });
</script>