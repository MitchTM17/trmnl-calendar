<link
    rel="stylesheet"
    href="https://trmnl.com/assets/plugins/calendars-8cda8897.css">
<link
    rel="stylesheet"
    href="https://trmnl.com/assets/plugins/calendars_full_week-0e0ce25b.css">
<style>
    /* FullCalendar's bundled CSS overrides color classes on .fc-event, so we strip its default chrome and paint events ourselves via eventContent below. */
    #calendar-full-week .fc-event,
    #calendar-full-week .fc-v-event,
    #calendar-full-week .fc-timegrid-event,
    #calendar-full-week .fc-daygrid-event {
        background: none !important;
        background-color: transparent !important;
        background-image: none !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }
    #calendar-full-week .fc-event-fill {
        display: block;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        padding: 2px 4px;
        overflow: hidden;
    }

    /* Black/gray-30/gray-55 are native 2-bit levels, so hex works. Gray-25/gray-60 need TRMNL's own bg--gray-* classes to get dithering. */
    #calendar-full-week .black-1,
    #calendar-full-week .black-2 {
        background-color: #000000 !important;
        border-color: #000000 !important;
    }
    #calendar-full-week .gray-30-1,
    #calendar-full-week .gray-30-2 {
        background-color: #4d4d4d !important;
        border-color: #4d4d4d !important;
    }
    #calendar-full-week .gray-55-1,
    #calendar-full-week .gray-55-2 {
        background-color: #8c8c8c !important;
        border-color: #8c8c8c !important;
    }
    #calendar-full-week .black-1,
    #calendar-full-week .black-2,
    #calendar-full-week .gray-30-1,
    #calendar-full-week .gray-30-2 {
        color: white !important;
        -webkit-text-stroke: 0 !important;
        text-shadow: none !important;
    }
    #calendar-full-week .gray-55-1,
    #calendar-full-week .gray-55-2 {
        color: black !important;
        -webkit-text-stroke: 0 !important;
        text-shadow: none !important;
    }

    {% comment %} Time Indicator Layer: "above" events (default) or "behind" them. {% endcomment %}
    #calendar-full-week .fc-timegrid-now-indicator-line {
        height: 2px !important;
        background-color: black !important;
        border: 0 !important;
        z-index: {% if trmnl.plugin_settings.custom_fields_values.now_indicator_layer == "behind" %}1{% else %}10{% endif %} !important;
    }
    #calendar-full-week .fc-timegrid-now-indicator-arrow {
        border-left-color: black !important;
        border-right-color: black !important;
        z-index: {% if trmnl.plugin_settings.custom_fields_values.now_indicator_layer == "behind" %}1{% else %}10{% endif %} !important;
    }
</style>
<div
    id="calendar-full-week"
    class="trmnl-calendar trmnl-calendar--week
        {% unless trmnl.plugin_settings.custom_fields_values.highlight_today == "false" %}highlight-today{% endunless %}
        {% unless trmnl.plugin_settings.custom_fields_values.shade_weekends == "true" %}no-weekend-shading{% endunless %}
        {% unless trmnl.plugin_settings.custom_fields_values.now_indicator_span == "day" %}now-indicator-full-week{% endunless %}">
</div>
<script src="https://usetrmnl.com/fullcalendar/index.global.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var calendarEl = document.getElementById("calendar-full-week");
        if (!calendarEl || typeof FullCalendar === "undefined") {
            return;
        }

        {% comment %} Time Zone Override: manual UTC-offset-in-hours (no IANA-to-offset filter exists in Liquid, so no DST auto-adjustment). Falls back to the account offset when blank. {% endcomment %}
        {% assign tzOverrideHours = trmnl.plugin_settings.custom_fields_values.time_zone_override %}
        {% if tzOverrideHours == nil or tzOverrideHours == "" %}
            {% assign effectiveOffset = trmnl.user.utc_offset %}
        {% else %}
            {% assign effectiveOffset = tzOverrideHours | times: 3600 %}
        {% endif %}

        var calendar = new FullCalendar.Calendar(calendarEl, {
            // Literal local wall-clock time; timeZone: "UTC" stops FullCalendar from re-converting it.
            now: "{{ trmnl.system.timestamp_utc | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' }}",
            timeZone: "UTC",

            {% comment %} ===== Auto-scroll window ===== {% endcomment %}
            {% comment %} Boolean fields don't alias to a bare variable here, so read everything via the qualified custom_fields_values path. {% endcomment %}
            {% assign scrollEnabled = trmnl.plugin_settings.custom_fields_values.auto_scroll_enabled %}
            {% assign startValue = trmnl.plugin_settings.custom_fields_values.auto_scroll_start | default: "08:00" %}
            {% assign endValue = trmnl.plugin_settings.custom_fields_values.auto_scroll_end | default: "20:00" %}

            {% comment %} Parse "HH:MM" into minutes-since-midnight. {% endcomment %}
            {% assign startParts = startValue | split: ":" %}
            {% assign startHour = startParts | first | plus: 0 %}
            {% assign startMin = startParts | last | plus: 0 %}
            {% assign endParts = endValue | split: ":" %}
            {% assign endHour = endParts | first | plus: 0 %}
            {% assign endMin = endParts | last | plus: 0 %}

            {% assign startTotalMin = startHour | times: 60 | plus: startMin %}
            {% assign endTotalMin = endHour | times: 60 | plus: endMin %}
            {% assign windowWidthMin = endTotalMin | minus: startTotalMin | plus: 1440 | modulo: 1440 %}

            {% comment %} Rotation frequency is hardcoded at 6h for now; a settings field for it comes later. {% endcomment %}
            {% if scrollEnabled == "true" %}
                {% assign freqMin = 360 %}
                {% assign nowHour = trmnl.system.timestamp_utc | plus: effectiveOffset | date: '%H' | plus: 0 %}
                {% assign nowMin = trmnl.system.timestamp_utc | plus: effectiveOffset | date: '%M' | plus: 0 %}
                {% assign nowTotalMin = nowHour | times: 60 | plus: nowMin %}
                {% assign shiftedMin = nowTotalMin | minus: startTotalMin | plus: 1440 | modulo: 1440 %}
                {% assign bucketIndex = shiftedMin | divided_by: freqMin %}
                {% assign bucketOffsetMin = bucketIndex | times: freqMin %}
                {% assign anchorMin = startTotalMin | plus: bucketOffsetMin | modulo: 1440 %}
            {% else %}
                {% assign anchorMin = startTotalMin %}
            {% endif %}
            {% assign windowEndMin = anchorMin | plus: windowWidthMin %}

            {% comment %} Format minutes-since-midnight back into "HH:MM:SS" (Liquid has no pad filter, so zero-pad via if/else). {% endcomment %}
            {% assign windowStartHour = anchorMin | divided_by: 60 %}
            {% assign windowStartMin = anchorMin | modulo: 60 %}
            {% if windowStartHour < 10 %}{% assign windowStartHourStr = "0" | append: windowStartHour %}{% else %}{% assign windowStartHourStr = windowStartHour | append: "" %}{% endif %}
            {% if windowStartMin < 10 %}{% assign windowStartMinStr = "0" | append: windowStartMin %}{% else %}{% assign windowStartMinStr = windowStartMin | append: "" %}{% endif %}
            {% assign windowStart = windowStartHourStr | append: ":" | append: windowStartMinStr | append: ":00" %}

            {% assign windowEndHour = windowEndMin | divided_by: 60 %}
            {% assign windowEndMinPart = windowEndMin | modulo: 60 %}
            {% if windowEndHour < 10 %}{% assign windowEndHourStr = "0" | append: windowEndHour %}{% else %}{% assign windowEndHourStr = windowEndHour | append: "" %}{% endif %}
            {% if windowEndMinPart < 10 %}{% assign windowEndMinStr = "0" | append: windowEndMinPart %}{% else %}{% assign windowEndMinStr = windowEndMinPart | append: "" %}{% endif %}
            {% assign windowEnd = windowEndHourStr | append: ":" | append: windowEndMinStr | append: ":00" %}

            // Display settings (our own fields, not tied to any one calendar slot)
            firstDay: {{ trmnl.plugin_settings.custom_fields_values.first_day | default: 0 }},
            scrollTime: {{ windowStart | json }},
            slotMinTime: {{ windowStart | json }},
            slotMaxTime: {{ windowEnd | json }},
            weekNumbers: {% if trmnl.plugin_settings.custom_fields_values.show_week_numbers == "true" %}true{% else %}false{% endif %},
            nowIndicator: {% unless trmnl.plugin_settings.custom_fields_values.show_now_indicator == "false" %}true{% else %}false{% endunless %},
            displayEventTime: {% if trmnl.plugin_settings.custom_fields_values.include_event_time == "true" %}true{% else %}false{% endif %},

            // Week-view layout
            headerToolbar: false,
            initialView: "timeGridWeek",
            contentHeight: "100%",
            expandRows: true,
            allDaySlot: true,
            slotDuration: "00:30:00",

            slotLabelFormat: {
                hour: "numeric",
                meridiem: "short",
                hour12: {% if trmnl.plugin_settings.custom_fields_values.time_format == "am/pm" %}true{% else %}false{% endif %}
            },
            eventTimeFormat: {
                hour: "numeric",
                minute: "2-digit",
                hour12: {% if trmnl.plugin_settings.custom_fields_values.time_format == "am/pm" %}true{% else %}false{% endif %}
            },

            // 10 calendar slots (2 per color). Each slot's plugin is user-picked via a plugin_instance_select dropdown; color comes from fillClass, read by eventContent below.
            // Events live under .merge_variables.events (not .events) since plugin_instance_select binds to the plugin instance itself.
            // Event times arrive as absolute UTC instants; each is shifted to the user's local offset and stripped of its "Z" suffix to match timeZone: "UTC" above.
            events: [

                {% comment %} Black 1 {% endcomment %}
                {% if black_1_source %}
                    {% for event in black_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "black-1" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Black 2 {% endcomment %}
                {% if black_2_source %}
                    {% for event in black_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "black-2" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 25 - 1 {% endcomment %}
                {% if gray_25_1_source %}
                    {% for event in gray_25_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-25 text--white" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 25 - 2 {% endcomment %}
                {% if gray_25_2_source %}
                    {% for event in gray_25_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-25 text--white" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 30 - 1 {% endcomment %}
                {% if gray_30_1_source %}
                    {% for event in gray_30_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-30-1" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 30 - 2 {% endcomment %}
                {% if gray_30_2_source %}
                    {% for event in gray_30_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-30-2" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 55 - 1 {% endcomment %}
                {% if gray_55_1_source %}
                    {% for event in gray_55_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-55-1" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 55 - 2 {% endcomment %}
                {% if gray_55_2_source %}
                    {% for event in gray_55_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "gray-55-2" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 60 - 1 {% endcomment %}
                {% if gray_60_1_source %}
                    {% for event in gray_60_1_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-60 text--black" }
                        },
                    {% endfor %}
                {% endif %}

                {% comment %} Gray 60 - 2 {% endcomment %}
                {% if gray_60_2_source %}
                    {% for event in gray_60_2_source.merge_variables.events %}
                        {% assign startTime = event.start_full | default: event.date_time %}
                        {% unless event.all_day %}
                            {% assign startTime = startTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {% assign endTime = event.end_full | default: event.end %}
                        {% unless event.all_day %}
                            {% assign endTime = endTime | date: '%s' | plus: effectiveOffset | date: '%Y-%m-%dT%H:%M:%S' %}
                        {% endunless %}
                        {
                            allDay: {% if event.all_day %}true{% else %}false{% endif %},
                            title: {{ event.summary | default: "" | json }},
                            description: {{ event.description | default: "" | json }},
                            start: {{ startTime | json }},
                            end: {{ endTime | json }},
                            extendedProps: { fillClass: "bg--gray-60 text--black" }
                        },
                    {% endfor %}
                {% endif %}

            ],

            // Renders each event as a plain uncontested <div> (see eventContent), since FullCalendar's own event chrome is neutralized above.
            eventContent: function (info) {
                var fillClass = (info.event.extendedProps && info.event.extendedProps.fillClass) || "";
                var fill = document.createElement("div");
                fill.className = "fc-event-fill " + fillClass;

                // info.timeText is only populated when displayEventTime (Include Event Time) is on.
                if (info.timeText) {
                    var time = document.createElement("div");
                    time.className = "fc-event-fill-time";
                    time.textContent = info.timeText;
                    fill.appendChild(time);
                }

                var title = document.createElement("div");
                title.className = "fc-event-fill-title";
                title.textContent = info.event.title || "";
                fill.appendChild(title);

                return { domNodes: [fill] };
            }
        });

        calendar.render();

        // Stretches the now-indicator line across all day columns instead of just today's.
        function updateNowIndicatorWidth() {
            try {
                var dayColumns = calendarEl.querySelectorAll("td.fc-timegrid-col:not(.fc-timegrid-axis)");
                var todayColumn = calendarEl.querySelector(".fc-day-today.fc-timegrid-col");
                if (!dayColumns.length || !todayColumn) {
                    return;
                }
                var firstBox = dayColumns[0].getBoundingClientRect();
                var lastBox = dayColumns[dayColumns.length - 1].getBoundingClientRect();
                var todayBox = todayColumn.getBoundingClientRect();

                calendarEl.style.setProperty("--now-indicator-left-offset", (todayBox.left - firstBox.left) + "px");
                calendarEl.style.setProperty("--now-indicator-total-width", (lastBox.right - firstBox.left) + "px");
            } catch (error) {
                // Ignore measurement errors during initial rendering.
            }
        }

        {% comment %} Only needed when Time Indicator Span is "Full week" - FullCalendar's own native per-day indicator needs no help otherwise. {% endcomment %}
        {% unless trmnl.plugin_settings.custom_fields_values.now_indicator_span == "day" %}
            // Measured a few times (not just once) since taller/shorter windows can delay when column layout actually settles.
            requestAnimationFrame(function () {
                requestAnimationFrame(updateNowIndicatorWidth);
            });
            setTimeout(updateNowIndicatorWidth, 300);
            if (window.ResizeObserver) {
                new ResizeObserver(updateNowIndicatorWidth).observe(calendarEl);
            }
        {% endunless %}
    });
</script>